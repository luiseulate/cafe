---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { badgeVariants } from '@/components/ui/badge'
import Layout from '@/layouts/layout.astro'
import { getSortedTags } from '@/lib/data-utils'
import { cn } from '@/lib/utils'

const tags = await getSortedTags()
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="Temas" />

  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Aqui podrás encontrar los temas que trato en mi <Link
            href="/blog"
            class="text-foreground"
            underline>blog</Link
          >.
        </p>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-2">
    <h2>
      Temas <span class="text-muted-foreground/40">({tags.length})</span>
    </h2>
    <div class="flex flex-wrap gap-2 border-t py-3">
      {
        tags.length === 0 ? (
          <p class="text-muted-foreground text-sm">No hay temas para mostrar</p>
        ) : (
          tags.map(({ tag, count }) => (
            <Link
              href={`/temas/${tag}`}
              class={cn(
                badgeVariants({ variant: 'muted' }),
                'origin-center hover:scale-105',
              )}
            >
              <span class="first-letter:uppercase">{tag}</span>
              <span class="text-muted-foreground">({count})</span>
            </Link>
          ))
        )
      }
    </div>
  </section>
</Layout>
