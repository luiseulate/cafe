---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { badgeVariants } from '@/components/ui/badge'
import Layout from '@/layouts/layout.astro'
import { getSortedTags } from '@/lib/data-utils'
import { cn } from '@/lib/utils'

const sortedTags = await getSortedTags()
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="Temas" />

  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Aqui podrás encontrar artículos relacionados con diferentes temas.
          Cada tema agrupa una colección de artículos que comparten una etiqueta
          común.
        </p>
        <p>
          Si quieres explorar todos los artículos, visita la página de <Link
            href="/blog"
            class="text-foreground"
            underline>blog</Link
          >.
        </p>
      </div>
    </div>
  </section>

  <div class="flex flex-wrap gap-2">
    {
      sortedTags.map(({ tag, count }) => (
        <Link
          href={`/temas/${tag}`}
          class={cn(
            badgeVariants({ variant: 'muted' }),
            'origin-center hover:scale-105',
          )}
        >
          <span class="first-letter:uppercase">{tag}</span>
          <span class="text-muted-foreground">({count})</span>
        </Link>
      ))
    }
  </div>
</Layout>
