---
import Colors from '@/components/colofón/design-colors.astro'
import Logo from '@/components/colofón/logo-preview.astro'
import StackIcons from '@/components/colofón/stack-icons.astro'

import Typography from '@/components/colofón/typography-preview.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { STACK_ICONS } from '@/consts'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="Colofón" />

  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Construido con Astro, Tailwind y shadcn/ui, basado en el tema <Link
            href="https://github.com/jktrn/astro-erudite"
            class="text-foreground"
            underline
            external>astro-erudite</Link
          > y alojado en Vercel. El código está disponible en <Link
            href="https://github.com/luiseulate/cafe"
            class="text-foreground"
            underline
            external>GitHub</Link
          >.
        </p>
      </div>
    </div>
  </section>
  <StackIcons links={STACK_ICONS} />
  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Para la tipografía se utiliza la fuente <Link
            href="https://vercel.com/font"
            class="text-foreground"
            underline
            external>Geist</Link
          > y <Link
            href="https://vercel.com/font"
            class="text-foreground"
            underline
            external>Geist Mono</Link
          >.
        </p>
      </div>
    </div>
  </section>
  <Typography />
  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          La paleta de colores está basada en el estándar de Tailwind en versión
          OKLCH de estilo minimalista y colores principalmente oscuros.
        </p>
      </div>
    </div>
  </section>
  <Colors />
  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          El logotipo es simplemente un icono de <Link
            href="https://lucide.dev/icons/coffee"
            class="text-foreground"
            underline
            external>Lucide Icons</Link
          >.
        </p>
      </div>
    </div>
  </section>
  <Logo />
  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Cada vez que alguien visita esta página se generan 0,02 g de CO2 según <Link
            href="https://www.websitecarbon.com/"
            class="text-foreground"
            underline
            external>Website Carbon Calculator</Link
          >.
        </p>
      </div>
    </div>
  </section>
</Layout>
