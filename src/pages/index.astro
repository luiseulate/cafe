---
import NowGaming from '@/components/home/now-gaming'
import NowListening from '@/components/home/now-listening'
import NowPosts from '@/components/home/now-posts.astro'
import NowReading from '@/components/home/now-reading'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import AvatarComponent from '@/components/ui/avatar'
import Birthday from '@/components/ui/birthday'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="Home" />

  <section class="flex flex-col gap-y-2">
    <div class="min-w-full">
      <div class="prose">
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam quis
          ligula lacinia, viverra nisl iaculis, maximus dui. Lorem ipsum dolor
          sit amet, consectetur adipiscing elit.
        </p>
      </div>
    </div>
    <div
      class="hover:bg-muted/50 -mx-4 rounded-xl p-4 transition-colors duration-300 ease-in-out"
    >
      <Link href="/blog" class="flex grow flex-wrap items-center gap-4">
        <AvatarComponent
          client:load
          src={SITE.avatar}
          alt={SITE.author}
          fallback="⌛"
          className={`size-20 rounded-md *:data-[slot="avatar-fallback"]:rounded-md`}
        />

        <div class="flex flex-col gap-0.5">
          <p class="font-medium">{SITE.author}</p>
          <Birthday client:load birthday={SITE.birthday} />
        </div>
      </Link>
    </div>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam quis
          ligula lacinia, viverra nisl iaculis, maximus dui.
        </p>
      </div>
    </div>
  </section>

  <NowPosts />

  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam quis
          ligula lacinia, viverra nisl iaculis, maximus dui.
        </p>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-2">
    <h2>Log</h2>

    <div class="group/posts">
      <NowListening client:load />
      <NowGaming client:load />
      <NowReading client:load />
    </div>
  </section>
</Layout>
