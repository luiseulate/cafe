---
import NowPosts from '@/components/bio/now-posts.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="Home" />

  <section class="flex flex-col gap-y-4">
    <h2>It's-a-me!</h2>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Me llamo Luis, este es el rincón digital, aquí encontrarás
          publicaciones sobre temas que despiertan mi curiosidad. ¡Gracias por
          visitar!
        </p>
      </div>
    </div>
  </section>

  <NowPosts />

  <section class="flex flex-col gap-y-4">
    <h2>Ahora</h2>
    <div class="min-w-full">
      <div class="prose">
        <ul>
          <li>Edición de video con DaVinci Resolve.</li>
          <li>Inteligencia artificial y sus aplicaciones.</li>
          <li>Oposiciones.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-y-4">
    <h2>Conectar</h2>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Puedes ver algunos de mis videos en <Link
            href="https://www.youtube.com/"
            class="text-foreground"
            external
            underline>YouTube</Link
          >.
        </p>
      </div>
    </div>
  </section>
</Layout>
