---
import BlogCard from '@/components/blog-card.astro'
import PageHead from '@/components/page-head.astro'
import Layout from '@/layouts/layout.astro'
import { getAllFotos, groupFotosByYear } from '@/lib/data-utils'

const allFotos = await getAllFotos()
const fotosByYear = groupFotosByYear(allFotos)
const years = Object.keys(fotosByYear).sort((a, b) => parseInt(b) - parseInt(a))
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="Fotos" />

  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Una colección de álbumes organizados por año. Fotografías de viajes,
          momentos y lugares que merecen ser recordados.
        </p>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-2">
    <h2>
      Fotos <span class="text-muted-foreground/40">({allFotos.length})</span>
    </h2>

    <div class="group/posts">
      {
        years.map((year) => (
          <div class="relative overflow-hidden border-t">
            <span class="text-muted-foreground pointer-events-none absolute top-3 text-sm tabular-nums select-none">
              {year}
            </span>
            <div>
              {fotosByYear[year].map((foto) => (
                <BlogCard entry={foto} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>
</Layout>
