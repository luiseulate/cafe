---
import PostHead from '@/components/post-head.astro'
import PostNavigation from '@/components/post-navigation.astro'
import Layout from '@/layouts/layout.astro'
import { getAdjacentFotos, getAllFotos, getFotoImages } from '@/lib/data-utils'
import { formatDateLong } from '@/lib/utils'
import { render } from 'astro:content'
import { Image } from 'astro:assets'

export async function getStaticPaths() {
  const fotos = await getAllFotos()
  return fotos.map((foto) => ({
    params: { id: foto.id },
    props: foto,
  }))
}

const post = Astro.props
const currentPostId = Astro.params.id
const { Content } = await render(post)
const navigation = await getAdjacentFotos(currentPostId)
const images = await getFotoImages(currentPostId)
---

<Layout>
  <PostHead slot="head" post={post} />

  <section
    class="grid grid-cols-[minmax(0px,1fr)_min(calc(var(--container-xl)-2rem),100%)_minmax(0px,1fr)] gap-y-6"
  >
    <section class="col-start-2 flex flex-col gap-y-1">
      <h1
        class="scroll-mt-31 text-2xl leading-tight font-medium"
        id="post-title"
      >
        {post.data.title}
      </h1>

      <span class="text-muted-foreground/60 text-sm"
        >{formatDateLong(post.data.date)}</span
      >
    </section>

    <article class="prose col-start-2 max-w-none">
      <Content />
    </article>

    {
      images.length > 0 && (
        <div class="col-start-2 max-w-none columns-1 gap-[2px] sm:columns-2">
          {images.map((image) => (
            <div class="mb-[2px] break-inside-avoid last:mb-0">
              <Image
                src={image}
                alt={post.data.title}
                class="bg-primary/10 w-full object-cover"
                widths={[400, 800, 1200]}
                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
              />
            </div>
          ))}
        </div>
      )
    }

    <PostNavigation
      newerPost={navigation.newer}
      olderPost={navigation.older}
      basePath="fotos"
    />
  </section>
</Layout>

<script>
  const ensureKatexStyles = () => {
    if (!document.querySelector('.katex')) return
    if (document.querySelector('link[href*="katex.min.css"]')) return

    const link = document.createElement('link')
    link.rel = 'stylesheet'
    link.href = 'https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css'
    document.head.appendChild(link)
  }

  document.addEventListener('astro:page-load', ensureKatexStyles)
  document.addEventListener('astro:after-swap', ensureKatexStyles)
</script>
