---
import PageHead from '@/components/page-head.astro'
import TechStack from '@/components/tech/tech-stack.tsx'
import Layout from '@/layouts/layout.astro'
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="Tech" />

  <section>
    <div class="min-w-full">
      <div class="prose">
        <p>
          A continuación indico qué aplicaciones utilizo en mi día a día, qué
          música escucho o qué utilizo para editar foto y video.
        </p>
      </div>
    </div>
  </section>
  <TechStack client:load />
</Layout>
