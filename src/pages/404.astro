---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/layout.astro'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="404" />

  <section
    class="flex flex-col items-center justify-center gap-y-4 text-center"
  >
    <div class="max-w-md">
      <h1 class="mb-4 text-3xl font-medium">¡Ups!</h1>
      <p class="prose">¡Vaya! La página que estás buscando no existe.</p>
    </div>

    <Image
      src="/404.svg"
      alt="404"
      width={320}
      height={320}
      widths={[240, 320, 480]}
      sizes="(max-width: 640px) 80vw, (max-width: 1024px) 50vw, 320px"
      class="mx-auto my-2 h-auto w-full max-w-[240px] sm:max-w-[320px]"
    />

    <Link
      href="/"
      class={cn(
        buttonVariants({ variant: 'outline' }),
        'flex gap-x-1.5 group bg-background/40 border-border/60 hover:bg-background/60 backdrop-blur-xl',
      )}
    >
      <Icon
        name="lucide:arrow-left"
        class="size-4 transition-transform duration-300 group-hover:-translate-x-1"
      /> Ir a la página de inicio
    </Link>
  </section>
</Layout>
