---
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import { buttonVariants } from '@/components/ui/button'
import Layout from '@/layouts/layout.astro'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="404" />

  <section
    class="flex grow flex-col items-center justify-center gap-y-4 text-center"
  >
    <h1 class="text-3xl font-medium">¡Ups!</h1>
    <p class="prose">¡Vaya! La página que estás buscando no existe.</p>

    <Link
      href="/"
      class={cn(
        buttonVariants({ variant: 'outline' }),
        'flex gap-x-1.5 group bg-background/40 hover:bg-background/60 backdrop-blur-xl',
      )}
    >
      <Icon
        name="lucide:arrow-left"
        class="size-4 transition-transform duration-300 group-hover:-translate-x-1"
      /> Inicio
    </Link>
  </section>
</Layout>
