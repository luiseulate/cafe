---
import NowListening from '@/components/home/now-listening'
import NowReading from '@/components/home/now-reading'
import NowRetroGaming from '@/components/home/now-retro-gaming'
import NowRunning from '@/components/home/now-running'
import NowWatching from '@/components/home/now-watching'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import Birthday from '@/components/ui/birthday'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
---

<Layout class="max-w-xl">
  <PageHead slot="head" title="Bio" />

  <Link
    href="/"
    class="text-muted-foreground/40 hover:text-muted-foreground/80 flex items-center gap-1 text-sm"
  >
    <Icon name="lucide:chevron-left" class="size-4" />
    Inicio
  </Link>

  <section class="flex flex-col gap-y-6">
    <Link href="/blog" class="group flex grow flex-wrap items-center gap-4">
      <Image
        src={SITE.avatar}
        alt={SITE.author}
        width={80}
        height={80}
        class="bg-primary/10 rounded-md object-cover transition-transform duration-300 group-hover:scale-105"
      />

      <div
        class="flex flex-col gap-0.5 transition-transform duration-300 group-hover:translate-x-0.5"
      >
        <p class="font-medium">{SITE.author}</p>
        <Birthday client:load birthday={SITE.birthday} />
      </div>
    </Link>
    <div class="min-w-full">
      <div class="prose">
        <p>
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nullam quis
          ligula lacinia, viverra nisl iaculis, maximus dui. Lorem ipsum dolor
          sit amet, consectetur adipiscing elit.
        </p>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-2">
    <h2>Actividad</h2>

    <div class="group/posts">
      <NowListening client:load />
      <NowWatching client:load />
      <NowReading client:load />
      <NowRetroGaming client:load />
      <NowRunning client:load />
    </div>
  </section>
</Layout>
