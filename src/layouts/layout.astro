---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/footer.astro'
import Head from '@/components/head.astro'
import Header from '@/components/header.astro'
import { SITE } from '@/consts'
import { cn } from '@/lib/utils'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<!doctype html>
<html class="bg-background text-foreground" lang={SITE.locale}>
  <Head>
    <slot name="head" />
  </Head>
  <body
    class="flex min-h-svh flex-col gap-y-12 bg-[url('/gradient.svg')] bg-top bg-no-repeat font-sans"
  >
    <header
      class="bg-background/60 sticky top-0 z-50 divide-y backdrop-blur-xs xl:divide-none"
    >
      <Header />
      <slot name="subposts-navigation" />
    </header>
    <main
      class={cn('w-full mx-auto flex grow flex-col gap-y-12 px-4', className)}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
