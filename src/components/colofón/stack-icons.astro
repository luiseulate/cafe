---
import Link from '@/components/link.astro'
import type { Stack } from '@/types'

type Props = { links: Stack[] }

const { links } = Astro.props
---

<ul
  class="relative grid list-none grid-flow-dense grid-cols-4 items-center justify-center gap-y-4 overflow-hidden px-2 py-4 sm:gap-y-8 sm:px-4 sm:py-8"
>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(var(--color-primary)_1px,transparent_1px)] bg-size-[1rem_1rem] bg-repeat sm:bg-size-[1.5rem_1.5rem] lg:bg-size-[1.25rem_1.25rem]"
  >
  </div>
  {
    links.map(({ href, label, icon: Icon }) => (
      <li class="bg-background/40 relative z-10 m-auto flex w-fit flex-row items-center justify-center rounded-lg p-4 backdrop-blur-3xl">
        <Link
          class="transition-transform duration-300 hover:scale-110 focus:scale-110"
          href={href}
          aria-label={label}
          title={label}
          external
        >
          <Icon class="h-6 w-6" aria-hidden="true" />
        </Link>
      </li>
    ))
  }
</ul>
