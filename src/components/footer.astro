---
import Link from '@/components/link.astro'
import { Separator } from '@/components/ui/separator'
import { Icon } from 'astro-icon/components'
import { getSecret } from 'astro:env/server'

const commitSha = getSecret('VERCEL_GIT_COMMIT_SHA')?.slice(0, 7) ?? '🤷‍♂️'
---

<footer class="bg-background/40 border-border/60 border-t backdrop-blur-xl">
  <div class="mx-auto flex max-w-xl flex-col gap-12 p-4 pt-8">
    <div class="flex justify-center sm:justify-start">
      <div class="flex items-center gap-4">
        <div
          class="border-border/60 bg-background text-primary flex h-12 w-12 items-center justify-center rounded-lg border"
        >
          <Icon name="lucide:sprout" class="size-5" />
        </div>
        <div class="flex flex-col items-start text-left">
          <h3 class="text-foreground text-sm">Creado desde la verde Navarra</h3>
          <span class="text-foreground/40 text-xs">
            Última actualización:
            <Link
              href="https://github.com/luiseulate/cafe"
              class="text-foreground/60 hover:text-foreground transition-colors"
              external
            >
              {commitSha}
            </Link>
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto flex max-w-xl flex-col p-4">
    <div
      class="text-foreground/60 flex flex-col items-center gap-2 text-xs sm:flex-row sm:justify-between"
    >
      <nav class="flex flex-wrap items-center gap-2">
        <Link
          href="/uses"
          class="text-foreground/60 hover:text-foreground transition-colors"
          underline
        >
          Uses
        </Link>
        <Separator orientation="vertical" className="h-4!" />
        <Link
          href="/colofón"
          class="text-foreground/60 hover:text-foreground transition-colors"
          underline
        >
          Colofón
        </Link>
      </nav>
      <span class="text-foreground/60">Hecho con ☕ y 🤍</span>
    </div>
  </div>
</footer>
