---
import Link from '@/components/link.astro'
import { NAV_LINKS, SITE } from '@/consts'
---

<footer class="bg-background/80 border-t backdrop-blur-md">
  <div class="mx-auto flex max-w-xl flex-col px-4 py-12">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      <div>
        <h4 class="text-foreground mb-3 text-sm">Menú</h4>
        <nav class="flex flex-col gap-2">
          {
            NAV_LINKS.map((item) => (
              <Link
                href={item.href}
                class="text-foreground/60 hover:text-foreground w-full text-sm capitalize transition-colors duration-300"
              >
                {item.label}
              </Link>
            ))
          }
        </nav>
      </div>

      <div>
        <h4 class="text-foreground mb-3 text-sm">Tech</h4>
        <nav class="flex flex-col gap-2">
          <Link
            href="/uses"
            class="text-foreground/60 hover:text-foreground text-sm transition-colors"
          >
            Uses
          </Link>
          <Link
            href="/colofón"
            class="text-foreground/60 hover:text-foreground text-sm transition-colors"
          >
            Colofón
          </Link>
        </nav>
      </div>

      <div>
        <h4 class="text-foreground mb-3 text-sm">Social</h4>
        <nav class="flex flex-col gap-2">
          <Link
            href="https://youtube.com/@luiseulate"
            class="text-foreground/60 hover:text-foreground text-sm transition-colors"
            external
          >
            YouTube
          </Link>
          <Link
            href="https://www.instagram.com/luiseulate"
            class="text-foreground/60 hover:text-foreground text-sm transition-colors"
            external
          >
            Instagram
          </Link>
        </nav>
      </div>
    </div>
  </div>

  <div class="mx-auto flex max-w-xl flex-col p-4">
    <div
      class="text-foreground/40 flex flex-col items-center gap-2 text-xs sm:flex-row sm:justify-between"
    >
      <div class="text-center sm:text-left">
        &copy; {new Date().getFullYear()}
        {SITE.title}. All rights reserved.
      </div>
      <span> Hecho con ☕ y 🤍</span>
    </div>
  </div>
</footer>
