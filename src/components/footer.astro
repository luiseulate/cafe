---
import NowCode from '@/components/footer/now-code'
import Link from '@/components/link.astro'
import { Separator } from '@/components/ui/separator'
import { Icon } from 'astro-icon/components'
---

<footer
  class="bg-background/40 flex w-full flex-col gap-6 border-t backdrop-blur-xl"
>
  <div class="mx-auto flex w-full max-w-xl grow flex-col px-4 pt-12">
    <div class="flex flex-col items-center gap-4 sm:items-start">
      <div
        class="bg-background/40 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border backdrop-blur-xl"
      >
        <Icon name="lucide:sprout" class="size-4" />
      </div>
      <div
        class="flex flex-col items-center gap-0.5 text-center sm:items-start sm:text-left"
      >
        <h3 class="text-foreground/80 text-sm">
          Creado desde la verde Navarra
        </h3>
        <NowCode client:load />
      </div>
    </div>
  </div>

  <div class="mx-auto flex w-full max-w-xl flex-col px-4 pb-12">
    <div
      class="text-foreground/60 flex items-center justify-center gap-2 text-xs sm:justify-start"
    >
      <Link
        href="/tech"
        class="text-foreground/60 hover:text-foreground transition-colors"
        underline
      >
        Tech
      </Link>
      <Separator orientation="vertical" className="h-4!" />
      <Link
        href="/colofón"
        class="text-foreground/60 hover:text-foreground transition-colors"
        underline
      >
        Colofón
      </Link>
    </div>
  </div>
</footer>
