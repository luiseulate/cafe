---
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const date = entry.data.date
const shortDate = `${date.getDate()}/${date.getMonth() + 1}`
---

<a
  href={`/${entry.collection}/${entry.id}`}
  class="border-border relative ml-16 flex flex-wrap items-center justify-between border-b py-3 transition-[opacity,border-color] duration-300 group-hover/posts:opacity-40 last:border-b-0 hover:opacity-100!"
>
  <p class="text-sm">{entry.data.title}</p>
  <span class="text-muted-foreground/40 shrink-0 text-sm tabular-nums"
    >{shortDate}</span
  >
</a>
