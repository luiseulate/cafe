---
import Link from '@/components/link.astro'
import { buttonVariants } from '@/components/ui/button'
import { NAV_LINKS } from '@/consts'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Astronav, MenuIcon, MenuItems } from 'astro-navbar'
---

<Astronav>
  <div class="w-full">
    <div
      class="mx-auto flex max-w-xl flex-wrap items-center justify-between gap-4 p-4"
    >
      <Link href="/" class="shrink-0">
        <Icon name="lucide:coffee" class="size-5" />
      </Link>
      <MenuIcon class="size-5 cursor-pointer sm:hidden" />
      <MenuItems
        class="hidden w-full sm:flex sm:w-auto sm:items-center sm:text-sm"
      >
        <ul class="grid grid-cols-2 gap-2 sm:contents">
          {
            NAV_LINKS.map((item) => (
              <li class="sm:contents">
                <Link
                  href={item.href}
                  class={cn(
                    buttonVariants({ variant: 'outline' }),
                    'text-foreground/60 hover:text-foreground w-full capitalize transition-colors duration-300',
                    'sm:h-auto sm:w-auto sm:border-0 sm:hover:bg-transparent',
                  )}
                >
                  {item.icon && (
                    <Icon
                      name={item.icon}
                      class="text-muted-foreground/20 size-3.5 sm:hidden"
                    />
                  )}
                  {item.label}
                </Link>
              </li>
            ))
          }
        </ul>
      </MenuItems>
    </div>
  </div>
</Astronav>
