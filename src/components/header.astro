---
import Link from '@/components/link.astro'
import { buttonVariants } from '@/components/ui/button'
import { NAV_LINKS } from '@/consts'
import { cn } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Astronav, MenuIcon, MenuItems } from 'astro-navbar'
---

<Astronav>
  <div class="w-full">
    <div
      class="mx-auto flex max-w-xl flex-wrap items-center justify-between gap-4 p-4"
    >
      <Link href="/" class="shrink-0">
        <Icon name="lucide:coffee" class="size-5" />
      </Link>
      <MenuIcon class="size-5 cursor-pointer sm:hidden" />
      <MenuItems class="hidden w-full sm:hidden">
        <ul class="grid grid-cols-2 gap-2">
          {
            NAV_LINKS.map((item) => (
              <li>
                <Link
                  href={item.href}
                  class={cn(
                    buttonVariants({ variant: 'outline' }),
                    'text-foreground/60 hover:text-foreground w-full capitalize transition-colors duration-300',
                  )}
                >
                  {item.icon && (
                    <Icon
                      name={item.icon}
                      class="text-muted-foreground/20 size-3.5"
                    />
                  )}
                  {item.label}
                </Link>
              </li>
            ))
          }
        </ul>
      </MenuItems>
      <nav class="hidden items-center gap-4 text-sm sm:flex sm:gap-6">
        {
          NAV_LINKS.map((item) => (
            <Link
              href={item.href}
              class="text-foreground/60 hover:text-foreground font-medium capitalize transition-colors duration-300"
            >
              {item.label}
            </Link>
          ))
        }
      </nav>
    </div>
  </div>
</Astronav>
